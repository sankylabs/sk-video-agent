# Public URL used in lead chat links (production)
PUBLIC_APP_URL=https://www.steamojikirkland.com

# Optional but recommended — smarter text helpers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Photoreal live video via Tavus
# https://maker.tavus.io/dev/api-keys
TAVUS_API_KEY=
TAVUS_PAL_ID=
TAVUS_PERSONA_ID=
TAVUS_REPLICA_ID=
TAVUS_FACE_ID=
TAVUS_MAX_DURATION=180

# Auto-text Maya links when a lead shows interest
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Shared secret for POST /api/webhooks/lead-interested
LEAD_WEBHOOK_SECRET=

# Postgres — conversation transcripts (Railway Postgres DATABASE_URL)
DATABASE_URL=

# GoHighLevel — live free-session calendar (availability + booking invites)
GHL_API_KEY=pit-your-private-integration-token
GHL_LOCATION_ID=your-location-id
GHL_CALENDAR_ID=m4L3dVKB7UyCfPFjQpK1
# Optional GHL custom field ids (Kirkland defaults are already in code)
# GHL_CHILD_NAME_FIELD_ID=YSjpyfW9xm77APzYjITK
