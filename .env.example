# Public URL used in SMS links (required in production)
PUBLIC_APP_URL=https://your-domain.com

# Optional but recommended — smarter text helpers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Photoreal live video via Tavus
# https://maker.tavus.io/dev/api-keys
TAVUS_API_KEY=
TAVUS_PAL_ID=
TAVUS_PERSONA_ID=
TAVUS_REPLICA_ID=
TAVUS_FACE_ID=
TAVUS_MAX_DURATION=600

# Auto-text Maya links when a lead shows interest
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Shared secret for POST /api/webhooks/lead-interested
LEAD_WEBHOOK_SECRET=
